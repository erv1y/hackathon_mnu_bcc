# Copy to .env and enter your own Gemini API key. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Web server (optional)
# DEMO_PASSWORD=
# AUDIT_DEMO_ONLY=1
# AUDIT_PROFILE=profiles/fintech-kz.json
# GRAPH_RUNS=1
# MAX_UPLOAD_MB=10

# Optional independent audit settings
# GEMINI_AUDITOR_MODEL=gemini-3.5-flash-lite
# GEMINI_AUDITOR_RETRY_MODEL=gemini-3.5-flash
# AUDIT_BATCH_SIZE=12
